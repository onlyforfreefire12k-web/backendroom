# ---- Telegram ----------------------------------------------------------------
# From @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ---- YouTube Data API v3 ------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_API_KEY=AIza...

# ---- Firebase Admin SDK (service account) ------------------------------------
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the full PEM on ONE line; keep the literal \n sequences — the backend
# converts them with private_key.replace("\\n", "\n")
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# REQUIRED — the exact URL of your Realtime Database, as shown in the
# Firebase console (Realtime Database tab). RTDB URLs are region-specific,
# for example:
# FIREBASE_DATABASE_URL=https://room-131c2-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=https://<your-project>-default-rtdb.<your-region>.firebasedatabase.app

# ---- Frontend ---------------------------------------------------------------
# The existing 3D room frontend origin (no trailing slash)
FRONTEND_URL=https://your-frontend-domain.com

# ---- Security ---------------------------------------------------------------
# Any long random string — signs the room join/session tokens
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
ROOM_TOKEN_SECRET=change-me-to-a-long-random-string

# Optional: join/session token lifetime in seconds (default 3600)
# ROOM_TOKEN_TTL_SECONDS=3600

# ---- Telegram Mini App ------------------------------------------------------
# REQUIRED — the Mini App short name registered in @BotFather (/newapp).
# JOIN ROOM buttons point to:
#   https://t.me/<bot_username>/<MINI_APP_SHORT_NAME>?startapp=<launch_code>
MINI_APP_SHORT_NAME=your-mini-app-short-name

# Optional: launch-code lifetime in seconds (default 1800)
# LAUNCH_CODE_TTL_SECONDS=1800

# Optional: max accepted age of Telegram initData in seconds (default 86400)
# WEBAPP_INITDATA_MAX_AGE_SECONDS=86400

# Render injects PORT automatically (default 10000)
PORT=10000
